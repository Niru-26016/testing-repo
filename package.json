{
  "name": "argus-store-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js + FastAPI Microservices Monorepo Target for Argus Production Debugger",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "backend": "python backend/run_microservices.py",
    "backend:test": "pytest backend/tests",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "nextjs",
    "fastapi",
    "argus",
    "docker",
    "monorepo"
  ]
}
